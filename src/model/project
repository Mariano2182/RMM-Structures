 analysis:{support:'fixed',subdivisions:6,Kx:1,Ky:1,Kz:1,Ly:6,Lz:6,Lb:1.5,loadPosition:'top',effectiveAreaRatio:0.85},
 loads:{dead:0.25,roofLive:0.60,windX:0.40,windRoof:0.35,source:'Valores ilustrativos. Reemplazar por acciones justificadas.',edition:'Acciones manuales; edición y aplicabilidad por confirmar'},
