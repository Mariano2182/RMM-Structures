 const roofY=x=>g.height+(g.roof==='flat'?0:g.roof==='mono'?x*g.slope:(g.span/2-Math.abs(x-g.span/2))*g.slope);
 const add=(id,type,a,b,frame=null)=>{const s=sections[type==='column'?'column':type==='rafter'?'rafter':'secondary'];const length=Math.hypot(...a.map((v,i)=>b[i]-v));parts.push({id,type,a,b,frame,profile:s.key,length,massKg:length*s.mass,section:s});};
 for(let i=0;i<g.frames;i++){
  const z=i*step;add(`C-L-${i+1}`,'column',[0,0,z],[0,roofY(0),z],i);add(`C-R-${i+1}`,'column',[g.span,0,z],[g.span,roofY(g.span),z],i);
  if(g.roof==='gable'){add(`R-L-${i+1}`,'rafter',[0,roofY(0),z],[g.span/2,roofY(g.span/2),z],i);add(`R-R-${i+1}`,'rafter',[g.span/2,roofY(g.span/2),z],[g.span,roofY(g.span),z],i);}
  else add(`R-${i+1}`,'rafter',[0,roofY(0),z],[g.span,roofY(g.span),z],i);
 }
 // Positions derive from maximum spacing measured on the slope. Ridge occurs once.
 const slopeFactor=Math.sqrt(1+(g.roof==='flat'?0:g.slope)**2),panels=g.roof==='gable'?2:1;
 const n=Math.ceil((g.span/panels)*slopeFactor/g.purlinSpacing),xs=Array.from({length:panels*n+1},(_,i)=>g.span*i/(panels*n));
 for(let bay=0;bay<g.frames-1;bay++){
  xs.forEach((x,k)=>add(`P-${bay+1}-${k+1}`,'purlin',[x,roofY(x),bay*step],[x,roofY(x),(bay+1)*step]));
  for(const [side,x] of [['L',0],['R',g.span]]){
   const top=roofY(x)-0.3,bottom=Math.min(1.2,top/2),count=Math.max(1,Math.ceil((top-bottom)/g.girtSpacing));
   for(let k=0;k<=count;k++){const y=bottom+(top-bottom)*k/count;add(`G-${side}-${bay+1}-${k+1}`,'girt',[x,y,bay*step],[x,y,(bay+1)*step]);}
  }
 }
 return {parts,step,sections,roofArea:g.span*g.length*slopeFactor,planArea:g.span*g.length,massKg:parts.reduce((s,x)=>s+x.massKg,0)};
}
