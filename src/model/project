export const ENGINE_VERSION='0.1.0';
export function newProject(){return {
 schemaVersion:1,id:globalThis.crypto?.randomUUID?.()||`project-${Date.now()}`,name:'Nave de ejemplo',location:'Córdoba — ubicación por confirmar',revision:1,
