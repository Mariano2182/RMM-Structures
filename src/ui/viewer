 draw(){if(!this.model)return;const {ctx,w,h}=prepare(this.canvas),parts=this.model.parts,ca=Math.cos(this.angle),sa=Math.sin(this.angle);const raw=v=>[ca*v[0]-sa*v[2],-.9*v[1]+.35*(sa*v[0]+ca*v[2])];
  const points=parts.flatMap(p=>[raw(p.a),raw(p.b)]),minX=Math.min(...points.map(p=>p[0])),maxX=Math.max(...points.map(p=>p[0])),minY=Math.min(...points.map(p=>p[1])),maxY=Math.max(...points.map(p=>p[1]));
  const scale=Math.min((w-60)/(maxX-minX||1),(h-90)/(maxY-minY||1))*this.zoom,project=v=>{const a=raw(v);return [(a[0]-(minX+maxX)/2)*scale+w/2,(a[1]-(minY+maxY)/2)*scale+h/2];};
  ctx.strokeStyle='#1d2a39';ctx.lineWidth=1;for(let i=20;i<w;i+=35){ctx.beginPath();ctx.moveTo(i,0);ctx.lineTo(i,h);ctx.stroke();}for(let i=20;i<h;i+=35){ctx.beginPath();ctx.moveTo(0,i);ctx.lineTo(w,i);ctx.stroke();}
  this.lines=parts.map(part=>({part,a:project(part.a),b:project(part.b)}));
