  ctx.font='11px Arial';ctx.fillStyle='#9bacbf';ctx.fillText('EJES DE BARRAS · ARRASTRAR PARA GIRAR',18,25);ctx.fillText('Columnas / cabios / secundarios',18,h-18);
 }
}
export function drawDiagram(canvas,c,type){
