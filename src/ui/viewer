 }
 for(const n of nodes.filter(v=>v.fix.some(Boolean))){const p=point(n.x,n.y);ctx.fillStyle='#9badc0';ctx.beginPath();ctx.moveTo(p[0],p[1]);ctx.lineTo(p[0]-9,p[1]+13);ctx.lineTo(p[0]+9,p[1]+13);ctx.closePath();ctx.fill();}
 ctx.font='12px Arial';ctx.fillStyle='#d1dbe6';ctx.fillText(type==='def'?`Deformada × ${amp.toFixed(1)} · máx. desplazamiento ${(max*1000).toFixed(2)} mm`:`Máx. |${type}| = ${max.toFixed(2)} ${type==='M'?'kN·m':'kN'}`,15,25);
 return {max,amp};
}
