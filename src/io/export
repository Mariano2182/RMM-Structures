export const escapeHTML=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
export function download(name,content,type='application/json'){
 const url=URL.createObjectURL(new Blob([content],{type})),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);
}
export function bomCSV(model){const q=v=>'"'+String(v).replaceAll('"','""')+'"';return '\ufeff'+[['Pieza','Tipo','Perfil','Longitud_m','Masa_kg','Alcance'],...model.parts.map(p=>[p.id,p.type,p.profile,p.length.toFixed(6),p.massKg.toFixed(3),'Sólo barras; sin placas, uniones, revestimiento ni desperdicio'])].map(r=>r.map(q).join(';')).join('\r\n');}
export function reportHTML(r){
 const e=escapeHTML,f=v=>Number.isFinite(v)?v.toLocaleString('es-AR',{maximumFractionDigits:4}):'No verificado';
 const table=(heads,rows)=>`<table><thead><tr>${heads.map(x=>`<th>${e(x)}</th>`).join('')}</tr></thead><tbody>${rows.map(row=>`<tr>${row.map(v=>`<td>${e(v)}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
 return `<!doctype html><html lang="es"><meta charset="utf-8"><title>Memoria — ${e(r.project.name)}</title><style>body{font:14px Arial;color:#172434;max-width:1100px;margin:40px auto;padding:0 24px}h1{color:#b95210}table{border-collapse:collapse;width:100%;font-size:11px;margin:16px 0}td,th{padding:7px;border:1px solid #bbc4cb;text-align:left}th{background:#eef2f5}.warning{padding:20px;background:#fff0d8;border:2px solid #bd6810}pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:11px}@media print{button{display:none}body{margin:0}tr{break-inside:avoid}thead{display:table-header-group}}</style><button onclick="print()">Imprimir / guardar PDF</button><h1>RMM Structures · Memoria de análisis</h1><h2>${e(r.project.name)}</h2><p>${e(r.project.location)} · revisión ${e(r.project.revision)} · motor ${e(r.engineVersion)} · ${e(r.createdAt)}</p><div class="warning"><b>VERIFICACIÓN GLOBAL INCOMPLETA · NO EMITE APTITUD PARA CONSTRUIR</b><p>Análisis elástico lineal de primer orden de pórticos 2D. Los estados individuales sólo describen los chequeos implementados con los datos ingresados.</p></div><h2>Alcance y pendientes</h2><ul>${r.pending.map(x=>`<li>${e(x)}</li>`).join('')}</ul><h2>Datos de entrada y supuestos</h2><pre>${e(JSON.stringify(r.project,null,2))}</pre><h2>Propiedades utilizadas · unidades m, kN, MPa</h2>${table(['Perfil','A (m²)','Ix (m⁴)','Iy (m⁴)','Sx (m³)','Zx (m³)','Fuente'],Object.values(r.model.sections).map(s=>[s.key,s.A,s.Ix,s.Iy,s.Sx,s.Zx,s.source]))}<h2>Casos, ancho tributario y equilibrio</h2>${table(['Caso','Ancho (m)','ΣFx (kN)','ΣFy (kN)','ΣM (kN·m)'],r.cases.map(c=>[c.id,f(c.width),...c.solution.balance.map(f)]))}<h2>Reacciones en apoyos</h2>${table(['Caso','Nodo','Rx (kN)','Ry (kN)','M (kN·m)'],r.cases.flatMap(c=>c.solution.reactions.map(v=>[c.id,v.id,f(v.Rx),f(v.Ry),f(v.M)])))}<h2>Chequeos por pieza · esfuerzos de primer orden</h2>${table(['Pieza','Chequeo','Demanda','Capacidad','Unidad','Índice','Caso','Estado','Referencia'],r.members.flatMap(m=>m.checks.map(c=>[m.id,c.id,f(c.demand),f(c.capacity),c.unit,f(c.ratio),c.caseId,c.status,c.reference])))}<h2>Servicio · límites de usuario</h2>${table(['Caso','Índice flecha relativa','Índice deriva','Máx |uy| nodal (mm)'],r.service.map(s=>[s.caseId,f(s.roofRatio),f(s.driftRatio),f(s.maxUy*1000)]))}<h2>Trazabilidad numérica de capacidades</h2>${r.members.map(m=>`<h3>${e(m.id)}</h3><pre>${e(JSON.stringify(m.capacities,null,2))}</pre>`).join('')}<h2>Cómputo de barras</h2><p>${r.model.parts.length} piezas · ${f(r.model.massKg)} kg. No incluye conexiones, revestimientos, desperdicios ni fundaciones.</p>${table(['Pieza','Perfil','Longitud (m)','Masa (kg)'],r.model.parts.map(p=>[p.id,p.profile,f(p.length),f(p.massKg)]))}<h2>Responsable de revisión</h2><p>Nombre, matrícula, firma y observaciones: pendientes de revisión profesional.</p></html>`;
}
