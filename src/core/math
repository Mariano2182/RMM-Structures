export const zeros=(n,m=n)=>Array.from({length:n},()=>Array(m).fill(0));
export const transpose=A=>A[0].map((_,j)=>A.map(r=>r[j]));
export const mv=(A,x)=>A.map(r=>r.reduce((s,v,j)=>s+v*x[j],0));
export const mm=(A,B)=>A.map(r=>B[0].map((_,j)=>r.reduce((s,v,k)=>s+v*B[k][j],0)));
export const dot=(a,b)=>a.reduce((s,v,i)=>s+v*b[i],0);
export function finite(v,name){if(typeof v!=='number'||!Number.isFinite(v))throw Error(`${name}: se requiere un número finito.`);return v;}
export function range(v,a,b,name){finite(v,name);if(v<a||v>b)throw Error(`${name}: debe estar entre ${a} y ${b}.`);return v;}
// Symmetric diagonal scaling and Cholesky. A non-positive pivot identifies a
// mechanism/non-SPD system, instead of silently adding artificial restraints.
export function solveSPD(A,b){
 const n=b.length;if(!n)return [];
 const scale=A.map((r,i)=>{if(!(r[i]>0))throw Error('Modelo inestable: grado de libertad sin rigidez.');return Math.sqrt(r[i]);});
 const L=zeros(n);
 for(let i=0;i<n;i++)for(let j=0;j<=i;j++){
  let s=A[i][j]/(scale[i]*scale[j]);for(let k=0;k<j;k++)s-=L[i][k]*L[j][k];
  if(i===j){if(s<1e-12||!Number.isFinite(s))throw Error('Modelo inestable o mal condicionado: revise apoyos y conectividad.');L[i][j]=Math.sqrt(s);}else L[i][j]=s/L[j][j];
 }
 const y=Array(n).fill(0),x=Array(n).fill(0);
 for(let i=0;i<n;i++){let s=b[i]/scale[i];for(let k=0;k<i;k++)s-=L[i][k]*y[k];y[i]=s/L[i][i];}
 for(let i=n-1;i>=0;i--){let s=y[i];for(let k=i+1;k<n;k++)s-=L[k][i]*x[k];x[i]=s/L[i][i];}
 return x.map((v,i)=>v/scale[i]);
}
