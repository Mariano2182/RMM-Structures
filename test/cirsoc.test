import test from 'node:test';import assert from 'node:assert/strict';import {section} from '../src/model/sections.js';import {newProject} from '../src/model/project.js';import {bucklingStress,capacities,checkMember} from '../src/codes/cirsoc301.js';
const p=newProject(),s=section('HEB300'),a=p.analysis,m=p.material;
const close=(x,y,tol=1e-8)=>assert.ok(Math.abs(x-y)<tol*Math.max(1,Math.abs(y)),`${x} != ${y}`);
test('E.3: ramas inelástica y elástica, valores independientes',()=>{close(bucklingStress(250,200000,50).Fcr,218.97,0.001);close(bucklingStress(250,200000,200).Fcr,43.2782153,1e-7);});
test('E.1: factor CIRSOC 0.85, no 0.90',()=>{const c=capacities(s,m,a,6),t=c.trace;close(c.compression,.85*s.A*Math.min(t.FcrX,t.FcrY,t.FcrZ));assert.equal(t.phiC,.85);});
test('D.2: factores de fluencia y rotura',()=>{const c=capacities(s,m,a,6);close(c.tensionYield,.9*250000*s.A);close(c.tensionRupture,.75*400000*s.A*.85);});
test('G.1: factor de corte 0.90',()=>{const c=capacities(s,m,a,6);assert.equal(c.trace.phiV,.9);close(c.shear,.9*.6*250000*s.d*s.tw*c.trace.Cv);});
test('F.2: reducción con Lb y tope plástico',()=>{for(const loadPosition of ['top','shearCenter']){const values=[.1,1,3,8,15].map(Lb=>capacities(s,m,{...a,Lb,loadPosition},6).bending);for(let i=1;i<values.length;i++)assert.ok(values[i]<=values[i-1]+1e-9);close(values[0],.9*Math.min(250000*s.Zx,1.5*250000*s.Sx));}});
test('F.2: continuidad en Lp y Lr',()=>{for(const loadPosition of ['top','shearCenter']){const c=capacities(s,m,{...a,loadPosition},6);for(const Lb of [c.trace.Lp,c.trace.Lr]){const x=capacities(s,m,{...a,Lb:Lb*(1-1e-8),loadPosition},6).bending,y=capacities(s,m,{...a,Lb:Lb*(1+1e-8),loadPosition},6).bending;assert.ok(Math.abs(x-y)/x<1e-6);}}});
test('Sección esbelta: fuera de alcance, no aprobación',()=>{const c=checkMember({...s,b:2,h:2,tw:.001,tf:.001},m,a,6,[{N:-10,M:1,V:1}]);assert.equal(c.capacities.compression,null);assert.equal(c.capacities.bending,null);assert.equal(c.checks.find(x=>x.id==='Flexión eje fuerte').status,'NO_VERIFICADO');});
test('H.1: demanda excedida se informa como no satisfecha',()=>assert.equal(checkMember(s,m,a,6,[{N:-100000,M:100000,V:100000}]).status,'NO_SATISFACE'));
